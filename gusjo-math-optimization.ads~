with Ada.Text_IO; use Ada.Text_IO;
with Gusjo.Math;  use Gusjo.Math;
With Gusjo;       use Gusjo;

package Gusjo.Math.Optimization is
   
   type Mode_Type is (Max, Min);
   
   type Sign_Restriction is (Positive, Negative, Free);
   
   type Model is private;
   
   type Variable is private;
   
   type Constraint is private;
   
   function Variable(Name : in My_String;
		     Restriction : in Sign_Restriction := Free) return Variable;
   
   function Variable(Name : in String;
		     Restriction : in Sign_Restriction := Free) return Variable;
   
   function Linear_Model(Mode : in Mode_Type) return Model;
   
private
   
   type Variable is
      record
	 Value       : Float;
	 Name        : My_String;
	 Restriction : Sign_Restriction;
      end record;
   
   type Constraint is
      record
	 I : Float; -- to be implemented
      end record;
   
   type Variable_List_Type is
     array(Positive range <>) of Variable;
   
   type Variable_List_Ptr_Type is
     access Variable_List_Type;
   
   type Constraint_List_Type is
     array(Positive range <>) of Constraint;
   
   type Constraint_List_Ptr_Type is
     access Constraint_List_Type;
   
   type Model is
      record
	 Mode        : Mode_Type;
	 Variables   : Variable_List_Ptr_Type;
	 Constraints : Constraint_List_Ptr_Type;
      end record;
   
end Gusjo.Math.Optimization;
