with Ada.Unchecked_Deallocation;

package body Gusjo.Ds.Stack is
   
   procedure Free is new Ada.Unchecked_Deallocation(Stack_Element_Type, Stack_Type);
   
   -- Stack
   procedure Push(Item:  in     Element_Type;
		  Stack: in out Stack_Type) is
   begin
      Stack := new Stack_Element_Type(Data => Item, Next => Stack);
   end Push;
   
   procedure Pop(Item:     out Element_Type;
		 Stack: in out Stack_Type) is
      Tmp : Stack_Type;
   begin
      if Stack /= null then
	 Item:= Stack.Data;
	 
	 Tmp := Stack.Next;
	 Free(Stack);
	 Stack := Tmp;
      else
	 raise Null_Pointer_Exception with "Stack is null";
      end if;
   end Pop;
   
   function Isempty(Stack: in Stack_Type) return Boolean is
   begin
      return Stack = null;
   end Isempty;
   
   function Top(Stack: in Stack_Type) return Element_Type is
   begin
      if Stack /= null then
	 return Stack.Data;
      else
	 raise Null_Pointer_Exception with "Stack is null";
      end if;
   end Top;
	 
   function Size(Stack: in Stack_Type) return Integer is
   begin
      if Stack = null then
	 return 0;
      else
	 return 1 + Size(Stack.Next);
      end if;
   end Size;

end Gusjo.Ds.Stack;
