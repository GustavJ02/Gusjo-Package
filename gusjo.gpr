project Gusjo is
   for Source_Dirs use ("./", "ai", "math", "ds", "io", "data", "usage_examples", "gpt", "cli", "tests");

   for Object_Dir  use "obj";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O3", "-march=native", "-gnatn");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use
      ("-Lobj",
         "-lgusjo_cuda",
         "-L/usr/local/cuda-12.8/targets/x86_64-linux/lib",
         "-lcublas",
         "-lcudart",
         "-Wl,-rpath,obj",
         "-Wl,-rpath,/usr/local/cuda-12.8/targets/x86_64-linux/lib");
   end Linker;

end Gusjo;