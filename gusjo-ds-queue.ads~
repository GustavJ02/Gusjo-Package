with Gusjo; use Gusjo;

generic
   type Element_Type is private;

package Gusjo.Ds.Queue is
   
   type Queue_Type is private;

   procedure Enqueue(Item:  in     Element_Type;
		     Queue: in out Queue_Type);
   
   procedure Dequeue(Item:     out Element_Type;
		     Queue: in out Queue_Type);
   
   function Isempty(Queue: in Queue_Type) return Boolean;
   
   function Front(Queue: in Queue_Type) return Element_Type;
   
   function Size(Queue: in Queue_Type) return Integer;
   
private

      type Queue_Element_Type is
	 record
	    Data: Element_Type;
	    Next: Queue_Element_Type;
	 end record;

      type Queue_Ptr_Type is
	access Queue_Element_Type;
      
      type Queue_Type is
	 record
	    Front: Queue_Ptr_Type;
	    Back: Queue_Ptr_Type;
	 end record;

end Gusjo.Ds.Queue;
